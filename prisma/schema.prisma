generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GameReservation {
  id                 String              @id @default(cuid())
  gameName           String
  hostName           String
  hostTokenHash      String?
  scheduledAt        DateTime
  maxPlayers         Int
  description        String              @default("")
  status             String              @default("OPEN")
  endedAt            DateTime?
  deletedAt          DateTime?
  cancellationReason String              @default("")
  revision           Int                 @default(0)
  editVersion        Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  participants       Participant[]
  waitlist           WaitlistEntry[]
  changes            ReservationChange[]
  removals           RosterRemoval[]
  visibility         String              @default("PUBLIC")
  inviteVersion      Int                 @default(1)
  inviteHash         String?
  inviteCipher       String?
  access             ReservationAccess[]

  @@index([scheduledAt])
  @@index([deletedAt, scheduledAt, id])
  @@index([deletedAt(sort: Desc), id])
}

model RosterRemoval {
  id              Int             @id @default(autoincrement())
  reservationId   String
  kind            String
  entryId         String
  targetTokenHash String
  targetName      String
  reason          String
  actorRole       String
  createdAt       DateTime        @default(now())
  reservation     GameReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, kind, entryId])
  @@index([reservationId, id])
  @@index([reservationId, targetTokenHash, id])
}

model ReservationChange {
  id                Int             @id @default(autoincrement())
  reservationId     String
  action            String
  actorRole         String
  fields            String
  scheduledAtBefore DateTime?
  scheduledAtAfter  DateTime?
  maxPlayersBefore  Int?
  maxPlayersAfter   Int?
  createdAt         DateTime        @default(now())
  reservation       GameReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, id])
}

model Participant {
  id                String          @id @default(cuid())
  reservationId     String
  name              String
  nameKey           String
  tokenHash         String
  checkedInAt       DateTime?
  attendanceVersion Int             @default(0)
  joinedAt          DateTime        @default(now())
  reservation       GameReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, nameKey])
  @@unique([reservationId, tokenHash])
  @@index([reservationId, joinedAt])
}

model WaitlistEntry {
  id            Int             @id @default(autoincrement())
  reservationId String
  name          String
  nameKey       String
  tokenHash     String
  joinedAt      DateTime        @default(now())
  reservation   GameReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, nameKey])
  @@unique([reservationId, tokenHash])
  @@index([reservationId, id])
}

model AdminCredential {
  id                   Int      @id @default(autoincrement())
  username             String   @unique
  passwordHash         String
  mustChangePassword   Boolean  @default(true)
  isActive             Boolean  @default(true)
  sessionVersion       Int      @default(0)
  bootstrapFingerprint String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Snapshots intentionally have no foreign keys: audit history survives permanent deletion.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     Int
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String
  createdAt   DateTime @default(now())

  @@index([createdAt, id])
  @@index([action, createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetType, targetId])
}

// No foreign key: a retry must never recreate a permanently deleted reservation.
model CreationRequest {
  id             String   @id @default(cuid())
  ownerTokenHash String
  key            String
  inputHash      String
  reservationId  String   @unique
  createdAt      DateTime @default(now())

  @@unique([ownerTokenHash, key])
}

model ReservationAccess {
  id            Int             @id @default(autoincrement())
  reservationId String
  tokenHash     String
  inviteVersion Int
  hasJoined     Boolean         @default(false)
  reservation   GameReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, tokenHash])
}
