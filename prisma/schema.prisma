generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GameReservation {
  id                 String        @id @default(cuid())
  gameName           String
  hostName           String
  hostTokenHash      String?
  scheduledAt        DateTime
  maxPlayers         Int
  description        String        @default("")
  status             String        @default("OPEN")
  deletedAt          DateTime?
  cancellationReason String        @default("")
  revision           Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  participants       Participant[]

  @@index([scheduledAt])
  @@index([deletedAt, scheduledAt])
}

model Participant {
  id            String          @id @default(cuid())
  reservationId String
  name          String
  nameKey       String
  tokenHash     String
  joinedAt      DateTime        @default(now())
  reservation   GameReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, nameKey])
  @@unique([reservationId, tokenHash])
  @@index([reservationId, joinedAt])
}

model AdminCredential {
  id                   Int      @id @default(autoincrement())
  username             String   @unique
  passwordHash         String
  mustChangePassword   Boolean  @default(true)
  isActive             Boolean  @default(true)
  sessionVersion       Int      @default(0)
  bootstrapFingerprint String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Snapshots intentionally have no foreign keys: audit history survives permanent deletion.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     Int
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String
  createdAt   DateTime @default(now())

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}
